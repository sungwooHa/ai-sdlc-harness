{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(__PACKAGE_MANAGER__ test)",
      "Bash(__PACKAGE_MANAGER__ test *)",
      "Bash(__PACKAGE_MANAGER__ test:harness)",
      "Bash(__PACKAGE_MANAGER__ test:harness *)",
      "Bash(__PACKAGE_MANAGER__ typecheck)",
      "Bash(__PACKAGE_MANAGER__ typecheck *)",
      "Bash(__PACKAGE_MANAGER__ check:harness)",
      "Bash(__PACKAGE_MANAGER__ check:harness *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git commit --no-v*)",
      "Bash(git commit * --no-v*)",
      "Bash(git commit -n*)",
      "Bash(git commit -an*)",
      "Bash(git commit * -n)",
      "Bash(git commit * -an)",
      "Bash(git commit * -n *)",
      "Bash(git -c *)",
      "Bash(git -C *)",
      "Bash(git --git-dir*)",
      "Bash(git --work-tree*)",
      "Bash(git --exec-path*)",
      "Bash(git --config-env*)",
      "Bash(*=* git commit*)",
      "Bash(*=* git push*)",
      "Bash(env * git commit*)",
      "Bash(env * git push*)",
      "Bash(*HARNESS_PLAN_APPROVED=*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/harness/ensure-husky.sh --quiet"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/plan-first.py prompt --repo-root \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/protected-paths-guard.py --repo-root \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/protected-paths-guard.py --repo-root \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/plan-first.py gate --repo-root \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/plan-first.py mark --repo-root \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      },
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/plan-first.py clear --repo-root \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/format-on-edit.py --repo-root \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      }
    ]
  }
}
