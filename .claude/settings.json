{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git commit --no-v*)",
      "Bash(git commit * --no-v*)",
      "Bash(git commit -n*)",
      "Bash(git commit -an*)",
      "Bash(git commit * -n)",
      "Bash(git commit * -an)",
      "Bash(git -c *)",
      "Bash(git -C *)",
      "Bash(git --git-dir*)",
      "Bash(git --work-tree*)",
      "Bash(git --exec-path*)",
      "Bash(git --config-env*)",
      "Bash(*=* git commit*)",
      "Bash(*=* git push*)",
      "Bash(env * git commit*)",
      "Bash(env * git push*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/harness/ensure-husky.sh --quiet"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/protected-paths-guard.py --repo-root \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/protected-paths-guard.py --repo-root \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      }
    ]
  }
}
